<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.common_ground_android.ui.fragments.SplashFragment"
        android:label="SplashFragment" />

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.common_ground_android.ui.fragments.LoginFragment"
        android:label="LoginFragment"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_profileSelectorFragment"
            app:destination="@id/profileSelectorFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.common_ground_android.ui.fragments.RegisterFragment"
        android:label="RegisterFragment"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_registerFragment_to_profileSelectorFragment"
            app:destination="@id/profileSelectorFragment" />
    </fragment>

    <fragment
        android:id="@+id/accountSettingsFragment"
        android:name="com.example.common_ground_android.ui.fragments.AccountSettingsFragment"
        android:label="AccountSettingsFragment"
        tools:layout="@layout/fragment_account_settings">
        <action
            android:id="@+id/action_accountSettingsFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/profileSelectorFragment"
        android:name="com.example.common_ground_android.ui.fragments.ProfileSelectorFragment"
        android:label="ProfileSelectorFragment"
        tools:layout="@layout/fragment_profile_selector">
        <action
            android:id="@+id/action_profileSelectorFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_profileSelectorFragment_to_createProfileFragment"
            app:destination="@id/createProfileFragment" />
        <action
            android:id="@+id/action_profileSelectorFragment_to_accountSettingsFragment"
            app:destination="@id/accountSettingsFragment" />
        <action
            android:id="@+id/action_profileSelectorFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.common_ground_android.ui.fragments.HomeFragment"
        android:label="HomeFragment"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_chatRouletteFragment"
            app:destination="@id/chatRouletteFragment" />
        <action
            android:id="@+id/action_homeFragment_to_groupRoomFragment"
            app:destination="@id/groupRoomFragment" />
        <action
            android:id="@+id/action_homeFragment_to_profileSelectorFragment"
            app:destination="@id/profileSelectorFragment" />
        <action
            android:id="@+id/action_homeFragment_to_selectInterestsFragment"
            app:destination="@id/selectInterestsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_homeFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/roomsFragment"
        android:name="com.example.common_ground_android.ui.fragments.RoomsFragment"
        android:label="RoomsFragment"
        tools:layout="@layout/fragment_rooms">
        <action
            android:id="@+id/action_roomsFragment_to_groupRoomFragment"
            app:destination="@id/groupRoomFragment" />
        <action
            android:id="@+id/action_roomsFragment_to_createRoomFragment"
            app:destination="@id/createRoomFragment" />
        <argument
            android:name="roomId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.common_ground_android.ui.fragments.ProfileFragment"
        android:label="ProfileFragment"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profileFragment_to_profileSelectorFragment"
            app:destination="@id/profileSelectorFragment" />
        <action
            android:id="@+id/action_profileFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_profileFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/chatRouletteFragment"
        android:name="com.example.common_ground_android.ui.fragments.ChatRouletteFragment"
        android:label="ChatRouletteFragment"
        tools:layout="@layout/fragment_chat_roulette">
        <action
            android:id="@+id/action_chatRouletteFragment_to_ratePartnerFragment"
            app:destination="@id/ratePartnerFragment" />
        <action
            android:id="@+id/action_chatRouletteFragment_to_reportFragment"
            app:destination="@id/reportFragment" />
        <action
            android:id="@+id/action_chatRouletteFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>

    <fragment
        android:id="@+id/groupRoomFragment"
        android:name="com.example.common_ground_android.ui.fragments.GroupRoomFragment"
        android:label="GroupRoomFragment"
        tools:layout="@layout/fragment_group_room">
        <action
            android:id="@+id/action_groupRoomFragment_to_roomManagementFragment"
            app:destination="@id/roomManagementFragment" />
        <argument
            android:name="roomId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/createRoomFragment"
        android:name="com.example.common_ground_android.ui.fragments.CreateRoomFragment"
        android:label="CreateRoomFragment"
        tools:layout="@layout/fragment_create_room">
        <action
            android:id="@+id/action_createRoomFragment_to_roomsFragment"
            app:destination="@id/roomsFragment" />
    </fragment>

    <fragment
        android:id="@+id/selectInterestsFragment"
        android:name="com.example.common_ground_android.ui.fragments.SelectInterestsFragment"
        android:label="SelectInterestsFragment"
        tools:layout="@layout/fragment_select_interests">
        <action
            android:id="@+id/action_selectInterestsFragment_to_chatRouletteFragment"
            app:destination="@id/chatRouletteFragment" />
    </fragment>

    <fragment
        android:id="@+id/ratePartnerFragment"
        android:name="com.example.common_ground_android.ui.fragments.RatePartnerFragment"
        android:label="RatePartnerFragment"
        tools:layout="@layout/fragment_rate_partner">
        <action
            android:id="@+id/action_ratePartnerFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>

    <fragment
        android:id="@+id/reportFragment"
        android:name="com.example.common_ground_android.ui.fragments.ReportFragment"
        android:label="ReportFragment"
        tools:layout="@layout/fragment_report">
        <action
            android:id="@+id/action_reportFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>

    <fragment
        android:id="@+id/roomManagementFragment"
        android:name="com.example.common_ground_android.ui.fragments.RoomManagementFragment"
        android:label="RoomManagementFragment"
        tools:layout="@layout/fragment_room_management">
        <action
            android:id="@+id/action_roomManagementFragment_to_groupRoomFragment"
            app:destination="@id/groupRoomFragment" />
        <argument
            android:name="roomId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/createProfileFragment"
        android:name="com.example.common_ground_android.ui.fragments.CreateProfileFragment"
        android:label="CreateProfileFragment"
        tools:layout="@layout/fragment_create_profile">
        <action
            android:id="@+id/action_createProfileFragment_to_profileSelectorFragment"
            app:destination="@id/profileSelectorFragment" />
        <action
            android:id="@+id/action_createProfileFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>