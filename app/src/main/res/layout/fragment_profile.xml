<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_surface"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_surface_container"
        android:elevation="@dimen/elevation_2"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:contentInsetStart="0dp"
            app:contentInsetEnd="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/toolbar_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile"
                    android:textColor="@color/md_on_surface"
                    android:textSize="@dimen/text_xl"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <ImageButton
                    android:id="@+id/edit_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/md_on_surface"
                    android:contentDescription="@string/edit"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/spacing_16"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/CardView.Rounded"
                app:cardCornerRadius="@dimen/corner_radius_28"
                app:cardElevation="@dimen/elevation_2"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_24">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_marginBottom="@dimen/spacing_24">

                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/profile_avatar"
                            android:layout_width="128dp"
                            android:layout_height="128dp"
                            android:src="@drawable/ic_person"
                            app:civ_border_width="4dp"
                            app:civ_border_color="@color/md_outline_variant" />

                        <ImageButton
                            android:id="@+id/avatar_edit_button"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/circle_background_primary"
                            android:src="@drawable/ic_camera"
                            android:layout_alignBottom="@id/profile_avatar"
                            android:layout_alignEnd="@id/profile_avatar"
                            android:layout_marginEnd="4dp"
                            android:layout_marginBottom="4dp"
                            android:visibility="gone"
                            android:contentDescription="@string/change_avatar" />

                        <ImageButton
                            android:id="@+id/avatar_clear_button"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/circle_background_secondary"
                            android:src="@drawable/ic_close"
                            android:layout_alignTop="@id/profile_avatar"
                            android:layout_alignStart="@id/profile_avatar"
                            android:layout_marginStart="4dp"
                            android:layout_marginTop="4dp"
                            android:visibility="gone"
                            android:contentDescription="@string/clear_avatar" />
                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/empty_profile_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone"
                        android:layout_marginBottom="@dimen/spacing_24">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fill_profile"
                            android:textColor="@color/md_on_surface_variant"
                            android:textSize="@dimen/text_sm"
                            android:layout_marginBottom="@dimen/spacing_12" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/fill_profile_button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Button.Filled"
                            android:text="@string/fill_profile_button"
                            android:textSize="@dimen/text_sm" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/name_input_layout"
                        style="@style/TextInputLayout.Rounded"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_16">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/name_edit_text"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/input_height"
                            android:hint="@string/name"
                            android:textColor="@color/md_on_surface"
                            android:textSize="@dimen/text_base" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/bio_input_layout"
                        style="@style/TextInputLayout.Rounded"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_24">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/bio_edit_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/enter_bio"
                            android:inputType="textMultiLine"
                            android:maxLines="3"
                            android:textColor="@color/md_on_surface"
                            android:textSize="@dimen/text_base" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:id="@+id/interests_view_mode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="@dimen/spacing_24"
                        android:visibility="visible">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/my_interests"
                            android:textColor="@color/md_on_surface"
                            android:textSize="@dimen/text_lg"
                            android:textStyle="bold"
                            android:layout_marginBottom="@dimen/spacing_8" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/selected_interests_chip_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:chipSpacingHorizontal="@dimen/spacing_8"
                            app:chipSpacingVertical="@dimen/spacing_4" />

                        <TextView
                            android:id="@+id/no_interests_hint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/no_interests"
                            android:textColor="@color/md_on_surface_variant"
                            android:textSize="@dimen/text_sm"
                            android:gravity="center"
                            android:paddingVertical="@dimen/spacing_24"
                            android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/interests_edit_mode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="@dimen/spacing_24"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/my_interests"
                            android:textColor="@color/md_on_surface"
                            android:textSize="@dimen/text_lg"
                            android:textStyle="bold"
                            android:layout_marginBottom="@dimen/spacing_8" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/interest_input_layout"
                            style="@style/TextInputLayout.Rounded"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:endIconMode="dropdown_menu"
                            android:layout_marginBottom="@dimen/spacing_16">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/interest_auto_complete"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/input_height"
                                android:hint="@string/type_to_search_interest"
                                android:inputType="text"
                                android:maxLines="1"
                                android:singleLine="true"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/edit_selected_interests_chip_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:chipSpacingHorizontal="@dimen/spacing_8"
                            app:chipSpacingVertical="@dimen/spacing_4" />
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/statistics_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/CardView.Rounded"
                        app:cardCornerRadius="@dimen/corner_radius_28"
                        app:cardElevation="@dimen/elevation_2"
                        android:layout_marginBottom="@dimen/spacing_16"
                        android:visibility="visible">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_24">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/statistics"
                                android:textColor="@color/md_on_surface"
                                android:textSize="@dimen/text_xl"
                                android:textStyle="bold"
                                android:layout_marginBottom="@dimen/spacing_24" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:gravity="center">

                                    <ImageView
                                        android:layout_width="56dp"
                                        android:layout_height="56dp"
                                        android:src="@drawable/ic_message_square"
                                        android:background="@drawable/circle_background_primary_container"
                                        android:padding="@dimen/spacing_12"
                                        app:tint="@color/md_on_primary_container"
                                        android:layout_marginBottom="@dimen/spacing_8" />

                                    <TextView
                                        android:id="@+id/sessions_count_text"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        tools:text="0"
                                        android:textColor="@color/md_on_surface"
                                        android:textSize="@dimen/text_2xl"
                                        android:textStyle="bold"
                                        android:layout_marginBottom="@dimen/spacing_4"
                                        android:text="0" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/chats"
                                        android:textColor="@color/md_on_surface_variant"
                                        android:textSize="@dimen/text_xs" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:gravity="center">

                                    <ImageView
                                        android:layout_width="56dp"
                                        android:layout_height="56dp"
                                        android:src="@drawable/ic_users"
                                        android:background="@drawable/circle_background_tertiary_container"
                                        android:padding="@dimen/spacing_12"
                                        app:tint="@color/md_on_tertiary_container"
                                        android:layout_marginBottom="@dimen/spacing_8" />

                                    <TextView
                                        android:id="@+id/rooms_count_text"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0"
                                        android:textColor="@color/md_on_surface"
                                        android:textSize="@dimen/text_2xl"
                                        android:textStyle="bold"
                                        android:layout_marginBottom="@dimen/spacing_4" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/rooms"
                                        android:textColor="@color/md_on_surface_variant"
                                        android:textSize="@dimen/text_xs" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:gravity="center">

                                    <ImageView
                                        android:layout_width="56dp"
                                        android:layout_height="56dp"
                                        android:src="@drawable/ic_trending_up"
                                        android:background="@drawable/circle_background_secondary_container"
                                        android:padding="@dimen/spacing_12"
                                        app:tint="@color/md_on_secondary_container"
                                        android:layout_marginBottom="@dimen/spacing_8" />

                                    <TextView
                                        android:id="@+id/matches_count_text"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0"
                                        android:textColor="@color/md_on_surface"
                                        android:textSize="@dimen/text_2xl"
                                        android:textStyle="bold"
                                        android:layout_marginBottom="@dimen/spacing_4" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/matches"
                                        android:textColor="@color/md_on_surface_variant"
                                        android:textSize="@dimen/text_xs" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/save_button"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        style="@style/Button.Filled"
                        android:text="@string/save"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:layout_marginBottom="@dimen/spacing_16"
                        android:visibility="visible" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/switch_profile_button"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        style="@style/Button.Outlined"
                        android:text="@string/switch_profile"
                        android:drawableStart="@drawable/ic_log_out"
                        android:drawableTint="@color/md_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/delete_profile_button"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        style="@style/Button.Outlined"
                        android:text="@string/delete_profile"
                        android:textColor="@color/md_error"
                        app:strokeColor="@color/md_error"
                        android:layout_marginTop="@dimen/spacing_16" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>