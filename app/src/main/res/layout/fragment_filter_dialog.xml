<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="500dp">

    <com.google.android.material.card.MaterialCardView
        style="@style/CardView.Rounded"
        app:cardCornerRadius="@dimen/corner_radius_28"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_24">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/filter_rooms"
                android:textColor="@color/md_on_surface"
                android:textSize="@dimen/text_xl"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/spacing_16" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/room_type"
                android:textColor="@color/md_on_surface"
                android:textSize="@dimen/text_lg"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/spacing_8" />

            <RadioGroup
                android:id="@+id/room_type_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/spacing_24">

                <RadioButton
                    android:id="@+id/all_rooms"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/all_rooms"
                    android:buttonTint="@color/radio_button_selector" />

                <RadioButton
                    android:id="@+id/my_rooms"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/my_rooms"
                    android:buttonTint="@color/radio_button_selector" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/interests"
                android:textColor="@color/md_on_surface"
                android:textSize="@dimen/text_lg"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/spacing_8" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/interest_input_layout"
                style="@style/TextInputLayout.Rounded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:endIconMode="dropdown_menu"
                android:layout_marginBottom="@dimen/spacing_16">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/interest_auto_complete"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:hint="@string/type_to_search_interest"
                    android:inputType="text"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/selected_interests_chip_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="@dimen/spacing_8"
                app:chipSpacingVertical="@dimen/spacing_4"
                android:layout_marginBottom="@dimen/spacing_24" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tags"
                android:textColor="@color/md_on_surface"
                android:textSize="@dimen/text_lg"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/spacing_8" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tag_input_layout"
                style="@style/TextInputLayout.Rounded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:endIconMode="dropdown_menu"
                android:layout_marginBottom="@dimen/spacing_16">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/tag_auto_complete"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:hint="@string/search_tags"
                    android:inputType="text"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/selected_tags_chip_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="@dimen/spacing_8"
                app:chipSpacingVertical="@dimen/spacing_4"
                android:layout_marginBottom="@dimen/spacing_24" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sort_by"
                android:textColor="@color/md_on_surface"
                android:textSize="@dimen/text_lg"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/spacing_8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/spacing_24">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/TextInputLayout.Rounded"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:endIconMode="dropdown_menu"
                    android:layout_marginEnd="@dimen/spacing_8">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/sort_by_spinner"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_height"
                        android:hint="@string/sort_by_criterion"
                        android:inputType="none"
                        android:maxLines="1"
                        android:paddingStart="16dp"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="@dimen/text_lg"
                    android:textColor="@color/md_on_surface_variant"
                    android:layout_marginStart="@dimen/spacing_4"
                    android:layout_marginEnd="@dimen/spacing_4" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/TextInputLayout.Rounded"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:endIconMode="dropdown_menu"
                    android:layout_marginStart="@dimen/spacing_8">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/sort_order_spinner"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_height"
                        android:hint="@string/sort_order"
                        android:inputType="none"
                        android:maxLines="1"
                        android:paddingStart="16dp"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/reset_button"
                    style="@style/Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reset"
                    android:layout_marginEnd="@dimen/spacing_8" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/apply_button"
                    style="@style/Button.Filled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/apply" />

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</ScrollView>