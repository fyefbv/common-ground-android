<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:paddingVertical="@dimen/spacing_8"
    android:paddingHorizontal="@dimen/spacing_16">

    <TextView
        android:id="@+id/system_message_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/md_on_surface_variant"
        android:textSize="@dimen/text_sm"
        android:background="@drawable/system_message_background"
        android:paddingHorizontal="@dimen/spacing_12"
        android:paddingVertical="@dimen/spacing_4"
        android:gravity="center" />
</LinearLayout>