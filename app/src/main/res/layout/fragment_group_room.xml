<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/md_surface"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_surface_container"
        android:elevation="@dimen/elevation_2">

        <com.google.android.material.appbar.MaterialToolbar
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:titleTextColor="@color/md_on_surface"
            app:contentInsetStart="0dp"
            app:contentInsetStartWithNavigation="0dp"
            app:contentInsetLeft="0dp"
            app:contentInsetLeftWithNavigation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/spacing_16">

                <ImageButton
                    android:id="@+id/back_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/md_on_surface" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="Комната"
                    android:textColor="@color/md_on_surface"
                    android:textSize="@dimen/text_xl"
                    android:textStyle="bold"
                    android:gravity="center" />

                <ImageButton
                    android:id="@+id/room_menu_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_more_vert"
                    app:tint="@color/md_on_surface" />

            </LinearLayout>

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/CardView.Rounded"
                app:cardCornerRadius="@dimen/corner_radius_20"
                app:cardElevation="@dimen/elevation_1"
                android:layout_margin="@dimen/spacing_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_16">

                    <TextView
                        android:id="@+id/room_name_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="Название комнаты"
                        android:textColor="@color/md_on_surface"
                        android:textSize="@dimen/text_xl"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/spacing_8" />

                    <TextView
                        android:id="@+id/room_description_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="Описание комнаты"
                        android:textColor="@color/md_on_surface_variant"
                        android:textSize="@dimen/text_sm"
                        android:layout_marginBottom="@dimen/spacing_12" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/primary_interest_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Технологии"
                        app:chipBackgroundColor="@color/md_tertiary_container"
                        android:textColor="@color/md_on_tertiary_container"
                        app:chipCornerRadius="@dimen/corner_radius_full"
                        android:layout_marginBottom="@dimen/spacing_12" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tags_label"
                        android:textColor="@color/md_on_surface_variant"
                        android:textSize="@dimen/text_sm"
                        android:layout_marginBottom="@dimen/spacing_4" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/room_tags_chip_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="@dimen/spacing_4"
                        app:chipSpacingVertical="@dimen/spacing_4"
                        android:layout_marginBottom="@dimen/spacing_12" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@color/md_surface_container_low"
                        android:padding="@dimen/spacing_12"
                        app:cornerRadius="@dimen/corner_radius_20">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_person"
                                    app:tint="@color/md_on_surface_variant"
                                    android:layout_marginEnd="@dimen/spacing_4" />

                                <TextView
                                    android:id="@+id/participants_count_text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    tools:text="24"
                                    android:textColor="@color/md_on_surface"
                                    android:textSize="@dimen/text_lg"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/participants_label"
                                android:textColor="@color/md_on_surface_variant"
                                android:textSize="@dimen/text_xs" />

                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="32dp"
                            android:background="@color/md_outline_variant" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_message_square"
                                    app:tint="@color/md_on_surface_variant"
                                    android:layout_marginEnd="@dimen/spacing_4" />

                                <TextView
                                    android:id="@+id/messages_count_text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    tools:text="128"
                                    android:textColor="@color/md_on_surface"
                                    android:textSize="@dimen/text_lg"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/messages_label"
                                android:textColor="@color/md_on_surface_variant"
                                android:textSize="@dimen/text_xs" />

                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="32dp"
                            android:background="@color/md_outline_variant" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_users"
                                    app:tint="@color/md_on_surface_variant"
                                    android:layout_marginEnd="@dimen/spacing_4" />

                                <TextView
                                    android:id="@+id/max_participants_text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    tools:text="50"
                                    android:textColor="@color/md_on_surface"
                                    android:textSize="@dimen/text_lg"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/max_label"
                                android:textColor="@color/md_on_surface_variant"
                                android:textSize="@dimen/text_xs" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/spacing_16"
                android:paddingVertical="@dimen/spacing_8"
                android:background="@color/md_surface_container">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/messages_title"
                    android:textColor="@color/md_on_surface"
                    android:textSize="@dimen/text_lg"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/online_count_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="12 онлайн"
                    android:textColor="@color/md_on_surface_variant"
                    android:textSize="@dimen/text_sm" />

                <TextView
                    android:id="@+id/show_participants_button"
                    style="@style/TextLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/room_members"
                    android:drawableEnd="@drawable/ic_chevron_right"
                    android:drawableTint="@color/md_primary"
                    android:layout_marginStart="@dimen/spacing_12" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/messages_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="400dp"
                android:padding="@dimen/spacing_8"
                tools:listitem="@layout/item_message"
                tools:itemCount="20" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="bottom"
        android:background="@color/md_surface_container"
        android:elevation="@dimen/elevation_3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_16"
            android:gravity="center_vertical">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/TextInputLayout.Rounded"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="@dimen/spacing_8">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/message_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="@string/type_message"
                    android:textColor="@color/md_on_surface"
                    android:textSize="@dimen/text_base"
                    android:maxLines="3" />

            </com.google.android.material.textfield.TextInputLayout>

            <ImageButton
                android:id="@+id/send_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/circle_background_primary"
                android:src="@drawable/ic_send"
                app:tint="@color/md_on_primary"
                android:contentDescription="@string/send" />

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>