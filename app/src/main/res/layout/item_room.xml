<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/CardView.Rounded"
    app:cardCornerRadius="@dimen/corner_radius_20"
    app:cardElevation="@dimen/elevation_1"
    android:layout_marginBottom="@dimen/spacing_12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_12">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/room_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:ellipsize="end"
                    tools:text="Название комнаты"
                    android:textColor="@color/md_on_surface"
                    android:textSize="@dimen/text_lg"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/spacing_4" />

                <TextView
                    android:id="@+id/room_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Описание комнаты"
                    android:textColor="@color/md_on_surface_variant"
                    android:textSize="@dimen/text_sm"
                    android:maxLines="4"
                    android:ellipsize="end"
                    android:layout_marginBottom="@dimen/spacing_8" />
            </LinearLayout>

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_rooms"
                android:background="@drawable/circle_background_primary_container"
                android:padding="@dimen/spacing_8"
                app:tint="@color/md_on_primary_container" />
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/tags_chip_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="@dimen/spacing_4"
            app:chipSpacingVertical="@dimen/spacing_4"
            android:layout_marginBottom="@dimen/spacing_12" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_12">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginEnd="@dimen/spacing_12">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_person"
                    app:tint="@color/md_on_surface_variant"
                    android:layout_marginEnd="@dimen/spacing_4" />

                <TextView
                    android:id="@+id/participants_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="0/50"
                    android:textColor="@color/md_on_surface_variant"
                    android:textSize="@dimen/text_sm" />
            </LinearLayout>

            <com.google.android.material.chip.ChipGroup
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:chipSpacingHorizontal="@dimen/spacing_8"
                app:chipSpacingVertical="@dimen/spacing_4">

                <com.google.android.material.chip.Chip
                    android:id="@+id/primary_interest_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Технологии"
                    app:chipBackgroundColor="@color/md_tertiary_container"
                    android:textColor="@color/md_on_tertiary_container"
                    app:chipCornerRadius="@dimen/corner_radius_full"
                    android:textSize="@dimen/text_xs" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/privacy_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Приватная"
                    app:chipBackgroundColor="@color/md_secondary_container"
                    android:textColor="@color/md_on_secondary_container"
                    app:chipCornerRadius="@dimen/corner_radius_full"
                    android:textSize="@dimen/text_xs" />

            </com.google.android.material.chip.ChipGroup>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/join_button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            style="@style/Button.Filled"
            android:text="@string/join"
            android:textSize="@dimen/text_sm"
            android:paddingStart="@dimen/spacing_16"
            android:paddingEnd="@dimen/spacing_16" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/leave_button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            style="@style/Button.Outlined"
            android:text="@string/leave"
            android:textSize="@dimen/text_sm"
            android:paddingStart="@dimen/spacing_16"
            android:paddingEnd="@dimen/spacing_16"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>