<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/md_surface"
    android:padding="@dimen/spacing_16"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/CardView.Rounded"
            app:cardCornerRadius="@dimen/corner_radius_28"
            app:cardElevation="@dimen/elevation_2"
            android:layout_marginBottom="@dimen/spacing_24">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_24"
                android:gravity="center">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_warning"
                    app:tint="@color/md_error"
                    android:layout_marginBottom="@dimen/spacing_16" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/report_title"
                    android:textColor="@color/md_on_surface"
                    android:textSize="@dimen/text_xl"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/spacing_8"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/report_description"
                    android:textColor="@color/md_on_surface_variant"
                    android:textSize="@dimen/text_sm"
                    android:layout_marginBottom="@dimen/spacing_24"
                    android:gravity="center" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@color/md_surface_container_low"
                    android:padding="@dimen/spacing_12"
                    app:cornerRadius="@dimen/corner_radius_20"
                    android:layout_marginBottom="@dimen/spacing_24">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/reported_user_avatar"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_person"
                        app:civ_border_width="1dp"
                        app:civ_border_color="@color/md_outline_variant" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/spacing_12">

                        <TextView
                            android:id="@+id/reported_user_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="Алексей"
                            android:textColor="@color/md_on_surface"
                            android:textSize="@dimen/text_base"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/chat_partner_label"
                            android:textColor="@color/md_on_surface_variant"
                            android:textSize="@dimen/text_sm" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/report_reason_title"
                    android:textColor="@color/md_on_surface"
                    android:textSize="@dimen/text_base"
                    android:layout_marginBottom="@dimen/spacing_8" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/reason_chip_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="@dimen/spacing_8"
                    app:chipSpacingVertical="@dimen/spacing_8"
                    android:layout_marginBottom="@dimen/spacing_20"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/reason_spam"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reason_spam"
                        style="@style/Widget.Material3.Chip.Filter" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/reason_harassment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reason_harassment"
                        style="@style/Widget.Material3.Chip.Filter" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/reason_inappropriate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reason_inappropriate"
                        style="@style/Widget.Material3.Chip.Filter" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/reason_other"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reason_other"
                        style="@style/Widget.Material3.Chip.Filter" />

                </com.google.android.material.chip.ChipGroup>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/TextInputLayout.Rounded"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_24"
                    app:counterEnabled="true"
                    app:counterMaxLength="500">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/details_edit_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/report_details"
                        android:inputType="textMultiLine"
                        android:maxLines="5"
                        android:textColor="@color/md_on_surface"
                        android:textSize="@dimen/text_base" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/submit_report_button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    style="@style/Button.Filled"
                    android:text="@string/submit_report" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cancel_report_button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    style="@style/Button.Outlined"
                    android:text="@string/cancel"
                    android:layout_marginTop="@dimen/spacing_12" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>